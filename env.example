# Copy this file to .env and fill in your own values. Never commit .env.

# Zenrows API key (dashboard > API key)
ZENROWS_API_KEY=

# Residential Proxies: full proxy URL from the dashboard, password revealed (not dots)
ZR_PROXY_URL=http://username:password@host:port
# A second proxy URL with the country set to France, for Leboncoin
ZR_PROXY_URL_FR=http://username:password@host:port

# Login test site (the-internet.herokuapp.com). The credentials are printed on its login page.
SITE_USER=
SITE_PASS=
